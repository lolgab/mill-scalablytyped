//| mill-version: 1.3.0
//| mvnDeps:
//|   - com.lihaoyi::mill-contrib-buildinfo:$MILL_VERSION
//|   - com.goyeau::mill-scalafix::0.6.0

package build

import mill.*
import mill.scalalib.*
import mill.scalalib.publish.*
import mill.contrib.buildinfo.BuildInfo
import mill.util.VcsVersion
import com.goyeau.mill.scalafix.ScalafixModule

def millBinaryVersion(millVersion: String) = millVersion.split('.').head
val millVersions = Seq("1.0.0")
val millBinaryVersions = millVersions.map(millBinaryVersion)

val scala212 = "2.12.20"

def millVersion(binaryVersion: String) =
  millVersions.find(v => millBinaryVersion(v) == binaryVersion).get

trait CommonPublish extends PublishModule {
  def pomSettings = PomSettings(
    description = "ScalablyTyped Mill Plugin",
    organization = "com.github.lolgab",
    url = "https://github.com/lolgab/mill-scalablytyped",
    licenses = Seq(License.`Apache-2.0`),
    versionControl = VersionControl.github("lolgab", "mill-scalablytyped"),
    developers = Seq(
      Developer("lolgab", "Lorenzo Gabriele", "https://github.com/lolgab")
    )
  )
  def publishVersion = Task { VcsVersion.vcsState().format() }
}

object `mill-scalablytyped`
    extends Cross[MillScalablyTypedCross](millBinaryVersions)
trait MillScalablyTypedCross
    extends ScalaModule
    with CommonPublish
    with BuildInfo
    with ScalafixModule
    with Cross.Module[String] { plugin =>
  def millBinaryVersion: String = crossValue
  override def artifactName = s"mill-scalablytyped_mill$millBinaryVersion"

  def scalaVersion = "3.7.3"
  override def compileMvnDeps = super.compileMvnDeps() ++ Seq(
    mvn"com.lihaoyi::mill-libs-scalajslib:${millVersion(millBinaryVersion)}"
  )
  def moduleDeps = Seq(`mill-scalablytyped-worker-api`)

  def buildInfoMembers = Seq(
    BuildInfo.Value("publishVersion", publishVersion()),
    BuildInfo.Value("scala212Version", scala212)
  )
  def buildInfoObjectName = "ScalablyTypedBuildInfo"
  def buildInfoPackageName = "com.github.lolgab.mill.scalablytyped"

  def scalacOptions =
    super.scalacOptions() ++ Seq("-Wunused:all", "-deprecation")

  /** Runs the projects in `itest/resources` with a real Mill launcher against
    * the plugin, worker and worker API published to test-local repositories.
    * Needs `node` and `npm` on the `PATH`.
    */
  object itest extends ScalaTests with TestModule.Utest {
    def mvnDeps = Seq(
      mvn"com.lihaoyi::mill-testkit:${millVersion(millBinaryVersion)}"
    )
    def forkEnv = Task {
      val testRepos = Seq(
        plugin.publishLocalTestRepo(),
        `mill-scalablytyped-worker-api`.publishLocalTestRepo(),
        `mill-scalablytyped-worker`.publishLocalTestRepo()
      ).map(_.path.toNIO.toUri.toASCIIString)
      val repos = testRepos ++
        Seq(Task.env.getOrElse("COURSIER_REPOSITORIES", "ivy2Local|central"))
      super.forkEnv() ++ Map(
        "MILL_EXECUTABLE_PATH" -> millExecutable.assembly().path.toString,
        "COURSIER_REPOSITORIES" -> repos.mkString("|"),
        "MILL_SCALABLYTYPED_TEST_VERSION" -> plugin.publishVersion()
      )
    }

    object millExecutable extends JavaModule {
      def mvnDeps = Seq(
        mvn"com.lihaoyi:mill-runner-launcher_3:${millVersion(millBinaryVersion)}"
      )
      def mainClass = Some("mill.launcher.MillLauncherMain")
    }
  }
}

object `mill-scalablytyped-worker-api` extends JavaModule with CommonPublish

object `mill-scalablytyped-worker` extends ScalaModule with CommonPublish {
  def moduleDeps = Seq(`mill-scalablytyped-worker-api`)
  def scalaVersion = scala212
  def mvnDeps = Seq(
    mvn"org.scalablytyped.converter::importer-portable:1.0.0-beta45",
    mvn"org.apache.logging.log4j:log4j-core:2.17.2"
  )
}
